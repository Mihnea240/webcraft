{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "maxNodeModuleJsDepth": 0,
    "baseUrl": ".",
    "typeRoots": ["./types", "./node_modules/@types"],
	"target": "ES2023",
    "lib": ["ES2023", "DOM"],

    "paths": {
      "@engine/*": ["./engine/*"],
      "@utils/*": ["./engine/utils/*"],
      "@resources/*": ["./resources/*"],
      "@web-components/*": ["./web_components/*"],
      "@examples/*": ["./examples/*"],
      "@chunk/*": ["./engine/chunk/*"],
      
      // Engine subsystems
      "@voxel/*": ["./engine/chunk/*"],
      "@block/*": ["./engine/block/*"],
      "@player/*": ["./engine/player/*"],
      "@world/*": ["./engine/world/*"],
    }
  },
  "include": [
    "engine/**/*.js",
    "web_components/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "**/*.min.js"
  ]
}
