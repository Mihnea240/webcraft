{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],
    "skipLibCheck": true,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/webcraft.tsbuildinfo",
    "paths": {
      "*": ["./*"],
      "@engine/*": ["./src/engine/*"],
      "@utils/*": ["./src/engine/utils/*"],
      "@web_components": ["./src/web_components/index.ts"],
      "@bedrock-types/*": ["./src/bedrock-types/*"],
      "web-components": ["../web-components/core/decorators/index"],
      "web-components/*": ["../web-components/core/*"]
    },
    "noImplicitAny": false
  },
  "include": [
    "src/**/*.ts",
    "demo/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "legacy",
    "**/*.min.js"
  ]
}
