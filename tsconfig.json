{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "typeRoots": ["./types", "./node_modules/@types"],
    "paths": {
      "@engine/*": ["./engine/*"],
      "@utils/*": ["./engine/utils/*"],
      "@resources/*": ["./resources/*"],
      "@web_components/*": ["./web_components/*"],
      "@examples/*": ["./examples/*"],
      "@chunk/*": ["./engine/chunk/*"],
      "@voxel/*": ["./engine/chunk/*"],
      "@block/*": ["./engine/block/*"],
      "@player/*": ["./engine/player/*"],
      "@world/*": ["./engine/world/*"],
      "web-components": ["../web-components/core/decorators/index"],
      "web-components/*": ["../web-components/core/*"]
    },
    "noImplicitAny": false
  },
  "include": [
    "engine/**/*.ts",
    "web_components/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "archive",
    "legacy",
    "**/*.min.js"
  ]
}
